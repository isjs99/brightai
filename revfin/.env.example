# Copy to .env and fill in. .env is gitignored. Never commit the real one.

# sandbox while building, production when ready
REVOLUT_ENV=sandbox

# One block per entity. The middle part must match the entity slug in
# config.yaml, upper-cased (uk -> REVOLUT_UK_*, de -> REVOLUT_DE_*).

# Brightform Social Media Limited (UK)
REVOLUT_UK_CLIENT_ID=
REVOLUT_UK_PRIVATE_KEY=secrets/uk-privatekey.pem
REVOLUT_UK_REDIRECT_URI=https://brightform.co/revolut-callback

# Brightform Social Media UG (DE). Needs its own certificate and consent
# even if the same person administers both accounts.
REVOLUT_DE_CLIENT_ID=
REVOLUT_DE_PRIVATE_KEY=secrets/de-privatekey.pem
REVOLUT_DE_REDIRECT_URI=https://brightform.co/revolut-callback

# Google Sheets push (revfin sheets push). Service account JSON key, kept in
# secrets/, and the id from the sheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
REVFIN_SHEET_ID=
