# Asana Personal Access Token (Asana > My settings > Apps > Developer apps > Personal access tokens)
ASANA_PAT=

# Admin password: full access, can change settings, deals, rules
DASHBOARD_PASSWORD=change-me

# Optional: account manager password. Read-only view of everything. Leave blank to disable.
AM_PASSWORD=

# Port the dashboard listens on
PORT=3000

# Where the SQLite file lives. In Docker this is on the /data volume.
DATABASE_PATH=./data/sweep.db

# Public URL of the dashboard, used for the "View run" link in Slack messages
PUBLIC_URL=http://localhost:3000

# Optional: secret used to sign the login cookie. Derived from DASHBOARD_PASSWORD if left blank.
SESSION_SECRET=

# Optional: Slack bot token (xoxb-...) for DM reminders to AMs. Needs chat:write, users:read, users:read.email.
SLACK_BOT_TOKEN=

# Optional: Cruva REST API key for the daily GMV sync (Cruva > Dashboard > API > API Key & Access).
CRUVA_API_KEY=
# Override only if Cruva's stats endpoint differs from the default (/v1/shop/stats on https://api.cruva.com).
CRUVA_BASE_URL=
CRUVA_STATS_PATH=
