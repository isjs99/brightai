# Admin password: full access, can change settings, deals, checklist items
DASHBOARD_PASSWORD=change-me

# Optional: account manager password. View everything and tick the checklist, change nothing else. Leave blank to disable.
AM_PASSWORD=

# Port the dashboard listens on
PORT=3000

# Where the SQLite file lives. In Docker this is on the /data volume.
DATABASE_PATH=./data/sweep.db

# Public URL of the dashboard, used for links in Slack messages
PUBLIC_URL=http://localhost:3000

# Optional: secret used to sign the login cookie. Derived from DASHBOARD_PASSWORD if left blank.
SESSION_SECRET=

# Optional: Slack bot token (xoxb-...) for DM reminders to AMs. Needs chat:write, users:read, users:read.email.
SLACK_BOT_TOKEN=

# Optional: Windsor.ai API key (Windsor.ai > API key). Windsor's TikTok Shop connector holds the shop authorisations,
# so the dashboard reads shops, orders, products and payouts without a Partner Center app. Feeds the GMV page.
WINDSOR_API_KEY=

# Optional: Cruva REST API key for the daily GMV sync (Cruva > Dashboard > API > API Key & Access).
CRUVA_API_KEY=
# Override only if Cruva's stats endpoint differs from the default (/v1/shop/stats on https://api.cruva.com).
CRUVA_BASE_URL=
CRUVA_STATS_PATH=
# Optional: Cruva CRM endpoint paths for the playbook page, JSON: {"automation": "/v1/automations", "group": "/v1/groups", ...}
CRUVA_ENDPOINTS=

# Optional: TikTok Shop Partner Center app, for pushing promotions to shops.
# Partner Center > Apps > your app > App key / App secret. Set the app's redirect URL to <PUBLIC_URL>/api/tts/callback.
TTS_APP_KEY=
TTS_APP_SECRET=

# Optional: any CSV URL to mirror as the lead list (overrides the Google Sheet id set in Leads settings).
# Without it the server reads the public CSV export of the sheet, which must be shared "Anyone with the link can view".
LEADS_CSV_URL=

# Optional: Apollo.io API key (Apollo > Settings > Integrations > API). Lets the BD pipeline find decision makers
# and reveal emails / LinkedIn (reveals cost Apollo credits and always ask first).
APOLLO_API_KEY=
# Optional: Google OAuth client (Web application) for the BD outreach Gmail link. Redirect URI: <PUBLIC_URL>/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: tl;dv API key so every recorded call gets a follow-up email drafted (Growth > Outreach emails > Call follow-ups)
TLDV_API_KEY=

# Optional: FastMoss API key (developers.fastmoss.com > MCP&CLI > API Keys). With it set the server talks to
# FastMoss's MCP endpoint (https://mcp.fastmoss.com/mcp) itself and pulls the fast risers every morning; no Claude session needed.
FASTMOSS_API_KEY=
# Optional: FASTMOSS_TRANSPORT=cli routes calls through the official CLI (npx -y @fastmoss/cli) instead of direct HTTPS.

# Optional: bearer token for POST /api/bd/import so a scheduled job can push fresh FastMoss "fast riser" pulls.
INGEST_TOKEN=

# Optional: Anthropic API key for the CS & affiliate inbox (draft replies and auto-reply). REPLY_MODEL defaults to claude-sonnet-5.
ANTHROPIC_API_KEY=
REPLY_MODEL=
