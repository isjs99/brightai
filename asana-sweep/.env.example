# Asana Personal Access Token (Asana > My settings > Apps > Developer apps > Personal access tokens)
ASANA_PAT=

# Admin password: full access, can change settings, deals, rules
DASHBOARD_PASSWORD=change-me

# Optional: account manager password. Read-only view of everything. Leave blank to disable.
AM_PASSWORD=

# Port the dashboard listens on
PORT=3000

# Where the SQLite file lives. In Docker this is on the /data volume.
DATABASE_PATH=./data/sweep.db

# Public URL of the dashboard, used for the "View run" link in Slack messages
PUBLIC_URL=http://localhost:3000

# Optional: secret used to sign the login cookie. Derived from DASHBOARD_PASSWORD if left blank.
SESSION_SECRET=

# Optional: Slack bot token (xoxb-...) for DM reminders to AMs. Needs chat:write, users:read, users:read.email.
SLACK_BOT_TOKEN=

# Optional: Cruva REST API key for the daily GMV sync (Cruva > Dashboard > API > API Key & Access).
CRUVA_API_KEY=
# Override only if Cruva's stats endpoint differs from the default (/v1/shop/stats on https://api.cruva.com).
CRUVA_BASE_URL=
CRUVA_STATS_PATH=

# Optional: TikTok Shop Partner Center app, for pushing promotions to shops.
# Partner Center > Apps > your app > App key / App secret. Set the app's redirect URL to <PUBLIC_URL>/api/tts/callback.
TTS_APP_KEY=
TTS_APP_SECRET=

# Optional: any CSV URL to mirror as the lead list (overrides the Google Sheet id set in Leads settings).
# Without it the server reads the public CSV export of the sheet, which must be shared "Anyone with the link can view".
LEADS_CSV_URL=

# Optional: Apollo.io API key (Apollo > Settings > Integrations > API). Lets the BD pipeline find decision makers
# and reveal emails / LinkedIn (reveals cost Apollo credits and always ask first).
APOLLO_API_KEY=

# Optional: bearer token for POST /api/bd/import so a scheduled job can push fresh FastMoss "fast riser" pulls.
INGEST_TOKEN=

# Optional: Anthropic API key for the CS & affiliate inbox (draft replies and auto-reply). REPLY_MODEL defaults to claude-sonnet-5.
ANTHROPIC_API_KEY=
REPLY_MODEL=
